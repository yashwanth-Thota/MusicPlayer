        android:layout_centerInParent="true" android:gravity="center_horizontal" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ECHO" android:textColor="#ffffff" android:textSize="46sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
