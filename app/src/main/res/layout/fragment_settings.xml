<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/listBackground">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true"
        android:layout_marginStart="16dp" android:layout_marginTop="20dp" android:text="Shake to change song"
        android:textColor="@color/trackTitle" android:textSize="15sp" />
    <Switch android:id="@+id/shakeSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_alignParentEnd="true" android:layout_marginEnd="16dp" android:layout_marginTop="14dp" />
</RelativeLayout>
