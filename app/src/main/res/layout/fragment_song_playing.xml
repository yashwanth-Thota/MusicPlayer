<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/av_bg">
    <com.cleveroad.audiovisualization.GLAudioVisualizationView
        android:id="@+id/visualizer_view" android:layout_width="match_parent" android:layout_height="match_parent"
        app:av_backgroundColor="@color/av_bg"
        app:av_bubblesPerLayer="16"
        app:av_bubblesRandomizeSizes="true"
        app:av_bubblesSize="@dimen/bubble_size"
        app:av_layersCount="4"
        app:av_wavesColors="@array/echo_wave_colors"
        app:av_wavesCount="7"
        app:av_wavesFooterHeight="@dimen/footer_height"
        app:av_wavesHeight="@dimen/wave_height" />
    <ImageButton android:id="@+id/favouriteButton" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_alignParentEnd="true" android:layout_marginEnd="24dp" android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_grey" android:padding="10dp" android:scaleType="fitCenter"
        android:src="@drawable/favorite_off" />
    <TextView android:id="@+id/songTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_above="@+id/songArtist" android:ellipsize="end" android:gravity="center" android:maxLines="1"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:textColor="#ffffff" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/songArtist" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_above="@+id/seekBar" android:layout_marginBottom="24dp" android:layout_marginTop="6dp"
        android:gravity="center" android:textColor="#f1f1f1" android:textSize="13sp" />
    <SeekBar android:id="@+id/seekBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_above="@+id/startTime" android:progressTint="@color/colorAccent" android:thumbTint="@color/colorAccent" />
    <TextView android:id="@+id/startTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_above="@+id/controls" android:layout_alignParentStart="true" android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp" android:textColor="#ffffff" android:textSize="12sp" />
    <TextView android:id="@+id/endTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_above="@+id/controls" android:layout_alignParentEnd="true" android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp" android:textColor="#ffffff" android:textSize="12sp" />
    <RelativeLayout android:id="@+id/controls" android:layout_width="match_parent" android:layout_height="80dp"
        android:layout_alignParentBottom="true" android:layout_marginBottom="28dp">
        <ImageButton android:id="@+id/playPauseButtonPlaying" android:layout_width="64dp" android:layout_height="64dp"
            android:layout_centerInParent="true" android:background="@drawable/pause_icon" />
        <ImageButton android:id="@+id/previousButton" android:layout_width="36dp" android:layout_height="36dp"
            android:layout_centerVertical="true" android:layout_marginEnd="26dp" android:layout_toStartOf="@id/playPauseButtonPlaying"
            android:background="@drawable/skip_previous" />
        <ImageButton android:id="@+id/nextButton" android:layout_width="36dp" android:layout_height="36dp"
            android:layout_centerVertical="true" android:layout_marginStart="26dp" android:layout_toEndOf="@id/playPauseButtonPlaying"
            android:background="@drawable/skip_next" />
        <ImageButton android:id="@+id/shuffleButton" android:layout_width="26dp" android:layout_height="26dp"
            android:layout_alignParentStart="true" android:layout_centerVertical="true" android:layout_marginStart="16dp"
            android:background="@drawable/shuffle_white_icon" />
        <ImageButton android:id="@+id/loopButton" android:layout_width="26dp" android:layout_height="26dp"
            android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginEnd="16dp"
            android:background="@drawable/loop_white_icon" />
    </RelativeLayout>
</RelativeLayout>
